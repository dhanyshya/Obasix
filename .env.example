# OBASIX AI Assistant (OpenAI-compatible Chat Completions API)
# Required for live answers from the floating chatbot.
# Keys stay server-side only — never prefix with NEXT_PUBLIC_.

OBASIX_AI_API_KEY=sk-your-key-here

# Optional overrides
# OBASIX_AI_BASE_URL=https://api.openai.com/v1
# OBASIX_AI_MODEL=gpt-4o-mini

# Fallback accepted by the server if OBASIX_AI_API_KEY is unset:
# OPENAI_API_KEY=
