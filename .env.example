# OBASIX AI Assistant (OpenAI-compatible Chat Completions API)
# Required for live answers from the floating chatbot.
# Keys stay server-side only — never prefix with NEXT_PUBLIC_.

OBASIX_AI_API_KEY=sk-your-key-here

# Optional overrides
# OBASIX_AI_BASE_URL=https://api.openai.com/v1
# OBASIX_AI_MODEL=gpt-4o-mini

# Fallback accepted by the server if OBASIX_AI_API_KEY is unset:
# OPENAI_API_KEY=

# Canonical site URL for metadata, sitemap and robots (production)
# NEXT_PUBLIC_SITE_URL=https://www.obasix.com

# Accounts — required in production
# AUTH_SECRET=
# OBASIX_AUTH_DB=.data/auth.sqlite

# Commerce: "demo" simulates payment (orders stored locally, nothing charged).
# Leave unset in production until a real provider is integrated.
# OBASIX_COMMERCE_MODE=demo
# ORDER_API_URL=
# ORDER_API_TOKEN=
# PAYMENT_WEBHOOK_SECRET=

# Quotes — external quote API (not yet integrated; demo store used in dev)
# QUOTE_API_URL=
# QUOTE_API_TOKEN=
