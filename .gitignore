# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# admin/ and api/ have their own .gitignore files for their build and tool output.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# typescript
*.tsbuildinfo

# testing (Playwright output for every config: default, integrations, migrations, api, ...)
/coverage
/test-results/
/test-results-*/
/playwright-report/
/playwright-report-*/
e2e/.tmp/

# python (anything outside api/)
__pycache__/
*.py[cod]

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local demo quote files, not a database
/.data/

# design tool and agent scratch output
.impeccable/review/
.impeccable/hook.cache.json
.playwright-mcp/
.claude/settings.local.json

# debug and logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# keys
*.pem
