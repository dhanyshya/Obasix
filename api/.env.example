# Same Postgres database as the Next.js site (it must be shared during the migration).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/obasix
APP_ENV=development
# Required in production, as on the site. Must equal the site's AUTH_SECRET once the "quotes" area is on (it signs the quote cookie).
AUTH_SECRET=
# The customer site's origin (comma-separated; add the admin panel's origin later).
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Same value as OBASIX_API_PROXY_SECRET on the site (32+ random characters).
OBASIX_API_PROXY_SECRET=
# Set to 1 only when the API is behind another proxy you control (not needed for the site's proxy).
TRUST_PROXY_HEADERS=0
OBASIX_ADMIN_EMAILS=
# Files: the same private Vercel Blob store as the site, or (without a token) the site's .data folder.
BLOB_READ_WRITE_TOKEN=
OBASIX_FILES_DIR=../.data
OBASIX_STAFF_ALERT_EMAILS=
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
LOG_LEVEL=INFO
